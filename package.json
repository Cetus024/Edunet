{
  "name": "edunets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "npm --prefix services/edunets-api run dev",
    "build": "npm run build:web && npm run api:build",
    "build:web": "next build",
    "start": "node scripts/preview.mjs",
    "api:build": "npm --prefix services/edunets-api run build",
    "api:start": "npm --prefix services/edunets-api run start",
    "api:test": "npm --prefix services/edunets-api run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:create": "tsx database/createDB.ts",
    "db:initialize": "tsx database/initializeDB.ts",
    "db:verify": "tsx database/verify-data.ts",
    "db:harden:supabase": "tsx database/harden-supabase.ts",
    "db:setup:supabase": "npm run db:create && npm run db:initialize && npm run db:harden:supabase",
    "db:delete": "tsx database/deleteDB.ts",
    "typecheck": "tsc --noEmit && npm --prefix services/edunets-api run typecheck",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run api:test && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@microsoft/power-apps": "^0.5.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.87.1",
    "@vercel/functions": "^3.7.6",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "jotai": "^2.14.0",
    "lucide-react": "^0.543.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "odata-v4-inmemory": "0.1.7",
    "odata-v4-parser": "0.1.29",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tar": "^7.5.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
