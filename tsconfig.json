{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./apps/web/*"],
      "@/app-gen-sdk/*": ["./app-gen-sdk/*"],
      "@/generated/*": ["./generated/*"]
    }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "api/**/*.ts",
    "packages/database/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "apps/web/out",
    "apps/api/dist",
    "app-gen-sdk/data/workiq/**",
    ".pytest-questionbank-full",
    ".pytest-questionbank-run",
    ".pytest-questionbank-targeted",
    ".questionbank-test-venv"
  ]
}
