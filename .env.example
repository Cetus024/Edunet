# Supabase PostgreSQL. Runtime uses the dedicated least-privilege role through
# Supavisor transaction mode; administration uses postgres through direct or
# session mode. URL-encode passwords before placing them in a connection URL.
DATABASE_URL=postgresql://edunets_app.PROJECT_REF:RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MILLIS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MILLIS=10000

# Better Auth and browser/API origins.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_EDUNETS_API_URL=http://localhost:8787

# Transactional emails. WEB_APP_URL is the frontend origin used in emailed
# invitation links. Both sender addresses must use a domain verified in Resend.
WEB_APP_URL=http://localhost:3000
RESEND_API_KEY=re_replace_with_resend_api_key
SQUAD_INVITE_FROM_EMAIL=EduNets <squad@updates.example.com>
AUTH_FROM_EMAIL=EduNets <account@updates.example.com>

# Capture Hub 2.0. Keep every credential server-side (never NEXT_PUBLIC_*).
# Azure Vision performs OCR on handwritten note images.
AZURE_VISION_ENDPOINT=https://YOUR-VISION-RESOURCE.cognitiveservices.azure.com
AZURE_VISION_KEY=replace-with-azure-vision-key

# Microsoft Foundry generates summaries and evaluates those summaries against
# the syllabus/database grounding. MODEL is the deployed model name.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com
AZURE_FOUNDRY_API_KEY=replace-with-foundry-api-key
AZURE_FOUNDRY_MODEL=replace-with-model-deployment-name

# Optional future fallback. If AZURE_FOUNDRY_* is absent, the same provider
# boundary can use ModelArts without changing Capture Hub code.
MODELARTS_ENDPOINT=
MODELARTS_API_KEY=
MODELARTS_MODEL=

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
