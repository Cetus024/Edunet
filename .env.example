# Supabase PostgreSQL. Runtime uses the dedicated least-privilege role through
# Supavisor transaction mode; administration uses postgres through direct or
# session mode. URL-encode passwords before placing them in a connection URL.
DATABASE_URL=postgresql://edunets_app.PROJECT_REF:RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MILLIS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MILLIS=10000

# Optional. Chemistry Smart Assessment (MCQ + Essay) reads APPROVED questions from
# the Question Bank Supabase project, matched by topic/subtopic title. Omit to
# keep using the local quiz_questions seed bank.
QUESTION_BANK_DATABASE_URL=postgresql://postgres.QUESTIONBANK_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Better Auth and browser/API origins.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_EDUNETS_API_URL=http://localhost:8787

# Transactional emails. WEB_APP_URL is the frontend origin used in emailed
# invitation links. Both sender addresses must use a domain verified in Resend.
WEB_APP_URL=http://localhost:3000
RESEND_API_KEY=re_replace_with_resend_api_key
SQUAD_INVITE_FROM_EMAIL=EduNets <squad@updates.example.com>
AUTH_FROM_EMAIL=EduNets <account@updates.example.com>

# Capture Hub 2.0. Keep every credential server-side (never NEXT_PUBLIC_*).
# Gemini 3.5 Flash scans handwritten notes, writes the detailed summary, and
# scores notes against retrieved textbook passages. Embeddings use the same key.
# Capture Hub Generate Notes and the Spidey chatbot use Flash-Lite so they stay cheaper than OCR.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Azure Vision OCR fallback when GEMINI_API_KEY is unset.
AZURE_VISION_ENDPOINT=https://YOUR-VISION-RESOURCE.cognitiveservices.azure.com
AZURE_VISION_KEY=replace-with-azure-vision-key

# Optional Microsoft Foundry fallback for summaries, evaluation, and embeddings
# when GEMINI_API_KEY is unset. MODEL is the deployed model name.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com
AZURE_FOUNDRY_API_KEY=replace-with-foundry-api-key
AZURE_FOUNDRY_MODEL=gpt-5-mini
# Underlying model ID; required when the deployment has a custom name.
AZURE_FOUNDRY_MODEL_ID=gpt-5-mini
# Embedding deployment used only if Gemini embeddings are not configured.
AZURE_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# Optional future fallback. If AZURE_FOUNDRY_* is absent, the same provider
# boundary can use ModelArts without changing Capture Hub code.
MODELARTS_ENDPOINT=
MODELARTS_API_KEY=
MODELARTS_MODEL=

# Optional. Concept Relay (Study Squad) uses Supabase Realtime Broadcast and
# Storage for drawing PNGs. Leave unset to rely on snapshot polling + mock mode.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
STUDY_RELAY_STORAGE_BUCKET=study-relay-drawings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
